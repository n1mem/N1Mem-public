# =====================================================================
# T1Mem BYOK Reproduction Package — environment template
# Copy to .env and fill in YOUR OWN keys. T1Mem never sees these.
# (Windows: set each line as `set KEY=value` instead of `source`.)
# =====================================================================

# --- Judge (REQUIRED for LoCoMo & LongMemEval reproduction) ---
# Your own OpenRouter key. The judge (openai/gpt-4o) is billed to YOU.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the judge model (default openai/gpt-4o).
# BYOK_JUDGE_MODEL=openai/gpt-4o

# --- Reader (ONLY needed for full end-to-end mode, NOT for judge-only Mode A) ---
# 百炼 (DashScope) key for T1Mem's multi-model reader (Qwen 3.7 Max / GLM 5.2 / DS V4-Pro).
# Leave empty if you only reproduce the judge on our frozen hypotheses.
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Embedding (local, NO key required) ---
# T1Mem uses a local BGE-M3 ONNX service (port 8114/8115). No key needed.
# EMBED_BACKEND=openai
# OPENAI_EMBED_BASE=http://127.0.0.1:8114/v1
# OPENAI_EMBED_MODEL=BAAI/bge-m3
# OPENAI_EMBED_DIM=1024
# OPENAI_EMBED_KEY=sk-local-none

# --- LongMemEval gold (REQUIRED for LME judge) ---
# Path to the gold mapping built from the OFFICIAL LongMemEval dataset.
# Build once: python longmemeval/build_gold.py --data <official_dir> --out longmemeval/inputs/lme_gold.json
LME_GOLD_DIR=longmemeval/inputs/lme_gold.json

# --- MemoryAgentBench (agent benchmark) ---
# Path to the OFFICIAL MemoryAgentBench repo you cloned.
# MEMORYAGENTBENCH_DIR=official_mab
